# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SESSION_SECRET=change-this-to-a-long-random-string

# ── Admin credentials ─────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=Prime Packaging Boxes <noreply@yourdomain.com>
SMTP_TO=info@primepackagingboxes.com
SMTP_SECURE=true

# ── Secondary SMTP (optional fallback) ───────────────────────────────────────
SMTP2_HOST=
SMTP2_PORT=
SMTP2_USER=
SMTP2_PASS=
SMTP2_FROM=
SMTP2_SECURE=false

# ── Clark AI (REQUIRED for chatbot to work) ───────────────────────────────────
# Clark uses Groq for fast LLM inference. Get a free key at https://console.groq.com
# WITHOUT this key, the Clark AI chatbot returns an error to website visitors.
# You can also set the Gemini API key in Admin → Settings → Clark AI (stored in DB)
# but the code currently uses Groq SDK — so GROQ_API_KEY is what actually works.
GROQ_API_KEY=your-groq-api-key-here
