        @media screen and (min-width:30rem){input[type=number]{background-position-x:calc(100% - 0.813rem);background-size:.5rem}select{background-position-x:calc(100% - 0.5rem);background-size:1rem}.btn-primary{max-width:fit-content}}@media screen and (min-width:48rem){:root{--container-max:56.25rem}}@media screen and (min-width:62rem){:root{--container-max:71.25rem}}@media screen and (min-width:75rem){:root{--container-max:82.5rem}}@media screen and (min-width:87.5rem){:root{--container-max:102.5rem}}}@layer components{.btn-primary,.btn-secondary,.btn-transparent{width:100%;text-align:center;font-size:var(--fs-base);font-weight:600}h1>*,h2>*,h3>*,h4>*{letter-spacing:.04em}.btn-primary,.btn-secondary{font-weight:600}.btn-primary,.pagination li>*{cursor:pointer;transition:var(--trans-3)}.btn-primary,.btn-primary .arrow,.btn-secondary,.btn-transparent,.pagination li>*{transition:var(--trans-3)}.container{width:100%;max-width:var(--container-max);padding-inline:1.25rem;margin:0 auto}.btn-primary{position:relative;display:block;background:var(--g-primary2);color:#fff;border-radius:var(--br-base);padding:.563rem .625rem;box-shadow:var(--shdw-primary);text-transform:capitalize;overflow:hidden}.btn-primary::before{content:"";position:absolute;z-index:0;inset:0;background:var(--c-secondary);opacity:0;transition:var(--trans-5)}.btn-primary:hover::before{opacity:1}.btn-primary>*{position:relative;z-index:1}.btn-primary .arrow{position:relative;display:inline-block;margin-left:.625rem;aspect-ratio:16/14;width:.875rem}.btn-secondary{background-color:var(--c-secondary);color:var(--c-primary);padding:.125rem 1.625rem}.btn-secondary:hover{background-color:var(--c-secondary-hover)}.btn-transparent{height:fit-content;background-color:#fff0;color:#000;text-decoration:underline;max-width:8.375rem;padding:.625rem .75rem;border:1px solid var(--c-primary)}.btn-transparent:hover{color:#fff;box-shadow:200px 0 0 var(--c-primary) inset}.btn.primary::selection{background-color:#fff;color:var(--c-primary)}.btn-width{max-width:12rem}.content>p:first-child:has(strong),.head>p:first-child:has(strong){line-height:var(--lh-tight)!important;display:block;width:fit-content;margin-bottom:0!important}.content>p:first-child>:is(strong),.head>p:first-child>:is(strong){line-height:var(--lh-tight);display:block;width:fit-content;margin-bottom:.625rem;position:relative;padding-left:1.5rem;font-family:var(--ff-secondary);font-size:var(--fs-base);color:var(--c-secondary);font-weight:500;text-transform:uppercase}.bread2 h1,h1>*,h2>*,h3>*,h4>*{color:var(--c-primary)}.content>p:first-child :is(strong)::before,.head>p:first-child :is(strong)::before{position:absolute;content:"";background:url(https://globalcustompackaging.com/theme/website/assets/images/icons/union.svg) center/contain no-repeat;width:20px;height:12px;inset:0 auto 0 0;margin-block:auto}
        .hidden-product {display: none;}
        h1>*,h2>*,h3>*,h4>*,h5>*,h6>*,.bread2 h1{letter-spacing: inherit; color: var(--c-primary);transform: translateZ(0); filter: var(--active-shadow); -webkit-filter: var(--active-shadow); font-weight: inherit; will-change: filter, font-size;}
        footer h2{color: var(--c-primary);transform: translateZ(0); filter: var(--active-shadow); -webkit-filter: var(--active-shadow); will-change: filter, font-size;}
        h1>*,h2>*,footer h2{--active-shadow: url(#shdw-sm);}
        h3>*,h4>*{--active-shadow: url(#shdw-base);}
        .bread2 h1 {--active-shadow: url(#shdw-sm);}
        /* ===== TABLET : 768px ===== */
        @media screen and (min-width:48rem){
            h1>*,h2>*,footer h2{--active-shadow: url(#shdw-md);}
            h3>*,h4>*{--active-shadow: url(#shdw-sm);}
            .bread2 h1 {--active-shadow: url(#shdw-md);}
        }
        /* ===== LAPTOP : 992px ===== */
        @media screen and (min-width: 62rem) {
            h2{font-weight: 800;}
            h1>*,h2>*,footer h2{--active-shadow: url(#shdw-lg);}
            .bread2 h1 {--active-shadow: url(#shdw-lg);}
        }
        
        @media screen and (min-width:38rem){.btn-primary .arrow{margin-left:.375rem}.btn-transparent{max-width:9.375rem}}.pagination{display:flex;align-items:center;gap:.625rem}.pagination li>*{width:1.5rem;height:1.5rem;display:flex;align-items:center;justify-content:center;color:var(--c-secondary);border-radius:var(--br-circle);font-size:var(--fs-xs);font-weight:500}.pagination li>:hover{background-color:#017B3A;color:#fff}.pagination li:first-of-type>:hover{background-color:#fff0}.pagination li:last-of-type>:hover{background-color:#fff0}.pagination :where(.prev,.next):hover img{box-shadow:0 0 19px 4px #bdbdbd;border-radius:50px}.pagination li>* img{width:auto;height:.875rem}.pagination li.active *{background-color:#017B3A;color:#fff}.pagination li>.active::selection{background-color:#fff;color:var(--c-primary)}.p-md,.p-sm{padding-block:1.25rem}.pt-sm{padding-top:1.25rem}.pb-sm{padding-bottom:1.25rem}.p-lg{padding-block:2.5rem}@media screen and (min-width:48rem){.p-sm{padding-block:1.5rem}.pt-sm{padding-top:1.5rem}.pb-sm{padding-bottom:1.5rem}.p-md{padding-block:1.875rem}.p-lg{padding-block:3rem}.btn-primary{max-width:13.5rem;padding:.706rem .625rem;border-radius:calc(var(--br-sm) + 2px)}}@media screen and (min-width:62rem){.btn-transparent{max-width:11.563rem}.btn-primary .arrow{margin-left:.625rem}.p-sm{padding-block:1.875rem}.pt-sm{padding-top:1.875rem}.pb-sm{padding-bottom:1.875rem}.p-md{padding-block:2.5rem}.p-lg{padding-block:3.75rem}}}.lazy{width:100%;height:auto;display:block;background:linear-gradient(120deg,#eee 25%,#ddd 37%,#eee 63%);background-size:400% 100%;animation:skeleton-loading 1s linear infinite;border-radius:var(--br-base)}@keyframes skeleton-loading{0%{background-position:100% 0}100%{background-position:-100% 0}}
        /* header CSS */
