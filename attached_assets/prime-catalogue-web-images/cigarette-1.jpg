    </style>
    <!-- Search -->
    <style>
        .search-product .prod-wrap .prod-card,.search-product .prod-wrap img{border-radius:var(--border-r-sm);overflow:hidden;transition:var(--trans-3)}.search-product{padding-block:1.25rem}.search-product h1{margin-bottom:1rem;color:var(--c-primary-lgt)}.search-product .main-wrapper{display:grid;gap:1.25rem}.search-product .prod-wrap{display:grid;gap:1rem}.search-product .prod-wrap .prod-card{display:flex;flex-direction:column;align-items:center;text-align:center}.search-product .prod-wrap img{background-color:var(--c-background-lgt)}.search-product .prod-wrap .prod-card:hover img{background-color:var(--c-background-drk)}.search-product .prod-wrap .prod-card>:nth-child(2){display:inline-block;margin-top:.625rem;transition:var(--trans-3)}.search-product .prod-wrap .prod-card:hover>:nth-child(2){color:var(--c-primary)}.search-product .main-wrapper .pagination{display:flex;align-items:center;justify-content:end;text-align:center;gap:.8rem;margin-block:0.875rem}.search-product .main-wrapper .pagination button{display:flex;align-items:center;justify-content:center;color:var(--c-text);border:1px solid var(--c-border-lgt);border-radius:.125rem;width:1.5rem;height:1.5rem;font-weight:600;font-size:var(--text-xs)}.search-product .main-wrapper .pagination button:hover{background-color:var(--c-primary);color:#fff}.search-product .main-wrapper .pagination button svg{stroke:var(--c-primary)}.search-product .main-wrapper .pagination button:hover svg{stroke:#fff}@media screen and (min-width:38rem){.search-product .main-wrapper .prod-wrap{grid-template-columns:repeat(2,1fr);gap:1.25rem}}@media screen and (min-width:48rem){.search-product{padding-block:3rem}.search-product h2{margin-bottom:1.25rem}.search-product .main-wrapper .prod-wrap{grid-template-columns:repeat(3,1fr)}.search-product .main-wrapper .pagination{text-align:center;margin-block:1.375rem}.search-product .main-wrapper .pagination button{width:2rem;height:1.875rem}}@media screen and (min-width:62rem){.search-product{padding-block:3.75rem}.search-product .main-wrapper{grid-template-columns:minmax(520px,1000px) minmax(412px,570px);gap:1.875rem}.search-product .main-wrapper .quote-form{position:sticky;height:fit-content;top:5rem}.search-product .main-wrapper .pagination{text-align:center;margin-block:1.875rem}.search-product .main-wrapper .prod-wrap{grid-template-columns:repeat(2,1fr)}}@media screen and (min-width:75rem){.search-product .main-wrapper .prod-wrap{grid-template-columns:repeat(3,1fr)}}
    </style>
    <!-- search modal -->
    <style>
        .search_form form {width: 100%; display: flex; justify-content: center; align-items: center; height: 100%; padding: 0 25%;}.search_form span {color: #fff; font-size: var(--fs-2xl); cursor: pointer; width: 100%; text-align: right; padding-right: 1.25rem; position: absolute; z-index: 99999;} .search_form.active {max-height: 100vh;} .search_form {width: 100%; height: 100%; background-color: rgba(0, 0, 0, .9); position: fixed; top: 0; left: 0; right: 0; z-index: 99999; max-height: 0; overflow: hidden; transition: max-height .4s;}.search_form form input {width: 85%; height: 3.75rem; outline: 0; border: none; background-color: #fff; padding: 0 0.625rem; font-size: var(--fs-base); color: #000; border-radius: 7px 0 0 7px;}.search_form form button {width: 15%; background-color: var(--c-primary); outline: 0; border: none; height: 3.75rem; font-weight: 700; transition: .3s; border-radius: 0 7px 7px 0;} @media (max-width:576px) {.search_form form {padding:0 0.625rem;}}
    </style>
    <!-- Quote Form -->
    <style>
        :root{--c-filebg :#667085;}
        .form > form input[type="file"]::file-selector-button {background: url("https://globalcustompackaging.com/theme/website/assets//images/file-bg.webp") no-repeat center; background-size:cover; color:var(--c-filebg); width: 6rem; height: 1.4375rem; padding-block: 0.28125rem; padding-inline: 0.90625rem; margin-right: 0.5rem; line-height:1; font-size:var(--fs-xs);}
        .form .btn-quote .arrow {margin-left:0;} .form>form>:first-child>:last-child,.form>form>:nth-child(3),.form>form>button{text-transform:capitalize;font-family:var(--ff-primary);font-size:var(--fs-xs)}.form .heading::after,.form .heading::before{content:"";position:absolute;width:calc(20% - 6%);height:.063rem;margin-block:auto;background:var(--ff-c-primary-dark-3)}:root{--ff-c-primary-dark-3:#009A4EBF}.form{max-width:40.625rem;margin-inline:auto;background:#fff;border-radius:var(--br-md);box-shadow:var(--shdw-sm);padding-inline:0.625rem;padding-block:1.125rem}.form>form input,.form>form select{font-size:var(--fs-xs);color:var(--c-text-lgt);border:solid 1.13px var(--c-border);border-radius:var(--br-base);padding-inline:0.5rem;height:2.1875rem}.form>form input[type=file]{padding-inline: 0.4375rem; padding-block:0.3125rem;line-height:normal;margin-bottom:1rem}.form>form select{background-position-x:calc(100% - 0.875rem);background-size:.4rem;cursor:pointer}.form>form input::placeholder,.form>form textarea::placeholder{color:var(--c-text-lgt)}.form>form>:first-child>:last-child,.form>form>:nth-child(3){width:100%;font-weight:500;display:block;color:var(--c-secondary-lgt)}.form>form>:nth-child(2){margin-bottom:.625rem}.form>form>:first-child,.form>form>:nth-child(3),.form>form>:nth-child(9){margin-bottom:.5rem}.form>form>input[type=file]::file-selector-button{padding-block:0.375rem;padding-inline:0.875rem;border:.64px solid #d8dee4;border-radius:var(--br-base)}.form>form>button{display:flex;justify-content:center;align-items:center;gap:.625rem;background:var(--g-primary2);padding-block:0.625rem;border:none;border-radius:var(--br-base);font-weight:800;color:#fff;position:relative;box-shadow:var(--btn-shadow);max-width:100%}.form>form>button:hover{background:var(--c-secondary)}.form .heading{position:relative;display:flex;justify-content:center;align-items:center;gap:.375rem;margin-bottom:.875rem}.form .heading::before{inset:0 0 0 0.375rem}.form .heading::after{inset