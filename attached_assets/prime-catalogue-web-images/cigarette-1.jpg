<script>
    document.addEventListener("DOMContentLoaded", () => {
        const sliderReview = document.querySelector(".reviews.slider");
        if (!sliderReview) return;

        const track = sliderReview.querySelector(".slider-container");
        const slides = [...sliderReview.querySelectorAll(".card")];
        const dotsContainer = sliderReview.querySelector(".slider-dots-container");

        const slideCount = slides.length;

        let currentIndex = 0;
        let slidesToShow = 1;
        let isVertical = false;
        let lastDotsCount = 0;

        let slideOffsets = [];

        function getLayoutConfig() {
            const w = window.innerWidth;

            if (w >= 992) {
                return {
                    slidesToShow: 3,
                    vertical: true
                };
            }

            if (w >= 576) {
                return {
                    slidesToShow: 2,
                    vertical: false
                };
            }

            return {
                slidesToShow: 1,
                vertical: false
            };
        }

        function cacheOffsets() {
            slideOffsets = slides.map(slide =>
                isVertical ? slide.offsetTop : slide.offsetLeft
            );
        }

        function createDots() {
            const totalDots = Math.ceil(slideCount / slidesToShow);

            if (totalDots === lastDotsCount) {
                updateDots();
                return;
            }

            lastDotsCount = totalDots;

            dotsContainer.textContent = "";

            const frag = document.createDocumentFragment();

            for (let i = 0; i < totalDots; i++) {

                const dot = document.createElement("button");

                dot.type = "button";
                dot.className = "slider-dot";
                dot.setAttribute("aria-label", `Go to slide ${i + 1}`);

                dot.addEventListener("click", () => updateSlider(i));

                frag.appendChild(dot);
            }

            dotsContainer.appendChild(frag);

            updateDots();
        }

        function updateDots() {

            dotsContainer.querySelectorAll(".slider-dot").forEach((dot, i) => {

                const active = i === currentIndex;

                dot.classList.toggle("active", active);

                if (active) {
                    dot.setAttribute("aria-current", "true");
                } else {
                    dot.removeAttribute("aria-current");
                }

            });
        }

        function updateSlider(index) {

            const maxPage = Math.ceil(slideCount / slidesToShow) - 1;

            if (index < 0) index = maxPage;
            if (index > maxPage) index = 0;

            currentIndex = index;

            let startIndex = index * slidesToShow;

            if (startIndex + slidesToShow > slideCount) {
                startIndex = Math.max(0, slideCount - slidesToShow);
            }

            const offset = slideOffsets[startIndex] || 0;

            track.style.transform = isVertical
                ? `translate3d(0,-${offset}px,0)`
                : `translate3d(-${offset}px,0,0)`;

            updateDots();
        }

        function handleResize() {

            const config = getLayoutConfig();

            slidesToShow = config.slidesToShow;
            isVertical = config.vertical;

            track.style.flexDirection = isVertical ? "column" : "row";

            const gap = isVertical ? 2.875 : 1;

            const basis = `calc((100% - ${(slidesToShow - 1) * gap}rem) / ${slidesToShow})`;

            slides.forEach(slide => {
                slide.style.flex = `0 0 ${basis}`;
            });

            requestAnimationFrame(() => {

                cacheOffsets();

                createDots();

                updateSlider(currentIndex);

            });
        }

        /* Touch */

        let startX = 0;
        let startY = 0;
        let dragging = false;

        track.addEventListener("touchstart", e => {

            dragging = true;
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;

        }, {
            passive: true
        });

        track.addEventListener("touchend", e => {

            if (!dragging) return;

            dragging = false;

            const dx = startX - e.changedTouches[0].clientX;
            const dy = startY - e.changedTouches[0].clientY;

            if (isVertical) {

                if (Math.abs(dy) > 50)
                    updateSlider(currentIndex + (dy > 0 ? 1 : -1));

            } else {

                if (Math.abs(dx) > 50)
                    updateSlider(currentIndex + (dx > 0 ? 1 : -1));

            }

        }, {
            passive: true
        });

        /* Mouse */

        let mx = 0;
        let my = 0;

        track.addEventListener("mousedown", e => {

            dragging = true;

            mx = e.clientX;
            my = e.clientY;

        });

        document.addEventListener("mouseup", e => {

            if (!dragging) return;

            dragging = false;

            const dx = mx - e.clientX;
            const dy = my - e.clientY;

            if (isVertical) {

                if (Math.abs(dy) > 50)
                    updateSlider(currentIndex + (dy > 0 ? 1 : -1));

            } else {

                if (Math.abs(dx) > 50)
                    updateSlider(currentIndex + (dx > 0 ? 1 : -1));

            }

        });

        let resizeTimer;

        window.addEventListener("resize", () => {

            clearTimeout(resizeTimer);

            resizeTimer = setTimeout(() => {
                requestAnimationFrame(handleResize);
            }, 150);

        });

        if (document.fonts) {
            document.fonts.ready.then(handleResize);
        } else {
            window.addEventListener("load", handleResize);
        }

    });
</script></main>


