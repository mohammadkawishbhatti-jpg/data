</head>
<body>
    <!-- SVG Filter -->
    <svg width="0" height="0" style="position: absolute; width: 0; height: 0; overflow: hidden;">
        <!-- 1. LARGE FILTER (Tight Bounds) -->
        <filter id="shdw-lg" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
            <feOffset dx="2" dy="2" in="SourceAlpha" result="offsetAlpha"/>
            <feComposite operator="out" in="SourceAlpha" in2="offsetAlpha" result="innerMask"/>
            <feFlood flood-color="#000000" flood-opacity="0.2" result="shadowColor"/>
            <feComposite operator="in" in="shadowColor" in2="innerMask" result="innerShadow"/>
            <feMerge>
            <feMergeNode in="SourceGraphic"/>
            <feMergeNode in="innerShadow"/>
            </feMerge>
        </filter>
        <!-- 2. MEDIUM FILTER (Tight Bounds) -->
        <filter id="shdw-md" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
            <feOffset dx="1.5" dy="1.5" in="SourceAlpha" result="offsetAlpha"/>
            <feComposite operator="out" in="SourceAlpha" in2="offsetAlpha" result="innerMask"/>
            <feFlood flood-color="#000000" flood-opacity="0.2" result="shadowColor"/>
            <feComposite operator="in" in="shadowColor" in2="innerMask" result="innerShadow"/>
            <feMerge>
            <feMergeNode in="SourceGraphic"/>
            <feMergeNode in="innerShadow"/>
            </feMerge>
        </filter>
        <!-- 3. SMALL FILTER (Tight Bounds) -->
        <filter id="shdw-sm" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
            <feOffset dx="1" dy="1" in="SourceAlpha" result="offsetAlpha"/>
            <feComposite operator="out" in="SourceAlpha" in2="offsetAlpha" result="innerMask"/>
            <feFlood flood-color="#000000" flood-opacity="0.2" result="shadowColor"/>
            <feComposite operator="in" in="shadowColor" in2="innerMask" result="innerShadow"/>
            <feMerge>
            <feMergeNode in="SourceGraphic"/>
            <feMergeNode in="innerShadow"/>
            </feMerge>
        </filter>
        <!-- 4. BASE FILTER (Tight Bounds) -->
        <filter id="shdw-base" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
            <feOffset dx="0.5" dy="0.5" in="SourceAlpha" result="offsetAlpha"/>
            <feComposite operator="out" in="SourceAlpha" in2="offsetAlpha" result="innerMask"/>
            <feFlood flood-color="#000000" flood-opacity="0.2" result="shadowColor"/>
            <feComposite operator="in" in="shadowColor" in2="innerMask" result="innerShadow"/>
            <feMerge>
            <feMergeNode in="SourceGraphic"/>
            <feMergeNode in="innerShadow"/>
            </feMerge>
        </filter>
    </svg>
    <!-- SVG Filter -->
    <div class="top-header">
        <div class="container">
            <div class="wrapper">
                <ul>
                    <li>Free Design Support</li>
                    <li>Fast Turnaround</li>
                    <li>Low Minimums.</li>
                </ul>
                <div class="top-contact">
                    <a href="tel:4252149690">
                        <img src="https://globalcustompackaging.com/theme/website/assets/images/icons/phone.svg" alt="Phone Vector Icon" width="14" height="14">
                        <p>(425)-214-9690</p>
                    </a>
                    <a href="https://globalcustompackaging.com/get-quote/" class="quote-btn">
                        <img src="https://globalcustompackaging.com/theme/website/assets/images/icons/custom.svg" alt="custom Vector Icon" width="14" height="16" fetchpriority="high">
                        <p>Get Custom Quote</p>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <header>
        <div class="container">
            <nav>
                <a href="https://globalcustompackaging.com/" ><img src="https://globalcustompackaging.com/theme/gallery_images/logo.svg" alt="Global Custom Packaging Logo" width="193" height="55"></a>
                <ul class="menu-links">
                    <li><a href="https://globalcustompackaging.com/">Home</a></li>
                    <li>
                        <a href="#" class="mega-toggle">Boxes By Industry</a>
                        <div class="mega-cont">
                            <div class="mega-menu">
                                <div>
                                    <strong class="heading">Apparel</strong>
                                    <ul>                                     
                                        <li><a href="https://globalcustompackaging.com/branded/shirt-boxes/" class="dropdown-item">Shirt Boxes</a></li> 
                                        <li><a href="https://globalcustompackaging.com/branded/bikini-boxes/" class="dropdown-item">Bikini Boxes</a></li>
                                        <li><a href="https://globalcustompackaging.com/branded/tights-boxes/" class="dropdown-item">Tights Boxes</a></li>
                                        <li><a href="https://globalcustompackaging.com/branded/shorts-boxes/" class="dropdown-item">Shorts Boxes</a></li>
                                        <li><a href="https://globalcustompackaging.com/branded/underwear-boxes/" class="dropdown-item">Underwear Boxes</a></li>
                                    </ul>
                                </div>
                                <div>
                                    <strong class="heading">Bakery</strong>
                                    <ul>
