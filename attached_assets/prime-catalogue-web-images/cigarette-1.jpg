    <script>
window.recaptchaScriptLoaded = window.recaptchaScriptLoaded || false;

function loadRecaptchaScript(callback) {
    if (window.recaptchaScriptLoaded) {
        callback();
        return;
    }

    // Prevent duplicate script tag
    if (document.getElementById('recaptchaScript')) {
        return;
    }

    const script = document.createElement('script');
    script.id = 'recaptchaScript';
    script.src = "https://www.google.com/recaptcha/api.js?onload=recaptchaReady&render=explicit";
    script.async = true;
    script.defer = true;

    window.recaptchaReady = function () {
        window.recaptchaScriptLoaded = true;
        callback();
    };

    document.body.appendChild(script);
}

function renderCaptcha(form) {
    let container = form.querySelector('.captchaContainer');

    // Prevent duplicate
    if (container) return;

    form.querySelector('.captcha').style.display = 'block';

    loadRecaptchaScript(() => {
        if (typeof grecaptcha !== "undefined") {

            // Create wrapper
            container = document.createElement("div");
            container.className = "captcha-wrap captchaContainer";

            // Create recaptcha div
            const captchaDiv = document.createElement("div");
            captchaDiv.className = "g-recaptcha";

            container.appendChild(captchaDiv);

            // Insert INTO placeholder (FIX)
            const placeholder = form.querySelector('.captcha-placeholder');
            placeholder.appendChild(container);

            const widgetId = grecaptcha.render(captchaDiv, {
                sitekey: "6LfhCHUtAAAAAByleXN3s9PjKriUxm6bro5WajuZ"
            });

            // SAVE widget ID
            captchaDiv.dataset.widget = widgetId;

            container.dataset.loaded = "true";
        }
    });
}

// Attach to all forms
document.querySelectorAll('.quote-form').forEach(form => {

    ['focusin', 'input', 'click'].forEach(event => {
        form.addEventListener(event, () => {
            renderCaptcha(form);
        }, { once: true });
    });
});
</script>


<script>
    document.getElementById("quoteForm").addEventListener("submit", function (e) {
        e.preventDefault();
        // Native validation check
        if (!this.checkValidity()) {
            return false; // stop if form is invalid
        }

        var response = grecaptcha.getResponse();
        if(response.length === 0) {
            alert("Please complete the captcha!");
            return false;
        }

        var formData = new FormData(this);
        formData.append('referring_page', window.location.href);
        document.getElementById("captchaFeedback").innerHTML = '';
        document.getElementById("full-screen-loader").style.display = "flex";

        fetch('https://globalcustompackaging.com/submitQuoteForm/', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
             document.getElementById("full-screen-loader").style.display = "none";
            if (data.success) {
                grecaptcha.reset();
                setTimeout(() => {
                    document.getElementById("quoteForm").reset();
                    window.location.href = 'https://globalcustompackaging.com/thank-you/';
                }, 500);

            }
             // Handle backend failure: object or string
            if (data.failure) {
                grecaptcha.reset();
                if (data.errors) {
                    showBackendErrors(data.errors); // object

                } else if (data.error) {
                    showBackendErrors(data.error); // string
                }

                return; // stop further actions
            }

            if(data.captcha_failure){
                grecaptcha.reset();
                document.getElementById("captchaFeedback").innerHTML = data.error;
                document.getElementById("captchaFeedback").style.display = "block";
            }

        })
        .catch(error => {
            console.error('Error:', error);
             document.getElementById("full-screen-loader").style.display = "none";
        });

    });



    function showBackendErrors(errorData) {
        const backendErrors = document.getElementById("backend_errors");
        backendErrors.innerHTML = ""; // clear old errors
        let errorMessages = [];
        // If errorData is an object (validation errors), get the values
        if (typeof errorData === 'object' && !Array.isArray(errorData)) {
            errorMessages = Object.values(errorData);
        } 
        // If errorData is a string, just wrap it in an array
        else if (typeof errorData === 'string') {
            errorMessages = [errorData];
        }

        const ul = document.createElement("ul");
        ul.style.margin = "0";
        ul.style.paddingLeft = "20px";

        errorMessages.forEach(msg => {
            const li = document.createElement("li");
            li.textContent = msg;
            ul.appendChild(li);
        });

        backendErrors.appendChild(ul);
        backendErrors.style.display = "block";

    }

</script>

        </div>
    </div>
</section>

<section class="service">
    <div class="container">
        <div class="content">
            <div class="head">
                <p><strong>SOLUTIONS BUILT AROUND YOU	</strong></p><h2>Find the <strong>Right Custom Box</strong> for Every Selling Moment</h2><p>Custom boxes should not force every brief into one familiar format. The right solution begins with what must be packed, where the box will be seen, how it will be handled and what the customer should understand when it opens. That can lead to a compact retail carton, a corrugated mailer, a rigid presentation box, a display structure, a fitted product set or a launch kit with several components. We connect structure, fit, visible brand space and interior arrangement around that real use, giving you a route that feels designed for the business goal rather than selected from a generic menu.</p>            </div>
        </div>
        <div class="wrapper">
                                                    <div class="card">
                <a class="image-box" href="
		https://globalcustompackaging.com/custom/product-boxes/	">
                                        <img data-src="https://globalcustompackaging.com/theme/gallery_images/1-Retail-Product-Boxes.webp" src="data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http://www.w3.org/2000/svg%22%20viewBox%3D%220%200%2038%2038%22%3E%3C/svg%3E" alt="1 Retail Product Boxes" width="479" height="322" class="lazy">
                    <div><span>➜</span></div>
                </a>
                <h3>	Retail & Product Boxes	</h3>
                <p>
		Turn a single product or coordinated range into a clear retail offer. Tuck, lock-bottom, sleeve, two-piece and window structures can be planned around product fit, information hierarchy and the way customers compare options.	</p>
                <ul>
                                                            <li>
		Single or grouped products	</li>
                                        <li>
		Fit-led closures and panels	</li>
                                        <li>
		Exterior and interior brand space	</li>
                                        <li>
		Retail, display or handoff	</li>
                                    </ul>
                <p>
		A focused retail box makes the product easier to recognize, understand and choose.	</p>
                <a href="
		https://globalcustompackaging.com/custom/product-boxes/	">Customize Now</a>
            </div>
                                        <div class="card">
                <a class="image-box" href="
		https://globalcustompackaging.com/branded/subscription-boxes/	">
                                        <img data-src="https://globalcustompackaging.com/theme/gallery_images/2-Mailer-Subscription-Boxes.webp" src="data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http://www.w3.org/2000/svg%22%20viewBox%3D%220%200%2038%2038%22%3E%3C/svg%3E" alt="2 Mailer Subscription Boxes" width="479" height="322" class="lazy">
                    <div><span>➜</span></div>
                </a>
                <h3>	Mailer & Subscription Boxes	</h3>
                <p>
		Carry the brand through delivery with mailer structures built around the product, recurring order or campaign. Printed interiors, inserts, dividers and opening details can make arrival feel connected to what was promised before the box appeared.	</p>
                <ul>
                                                            <li>
		Products, subscriptions or campaigns	</li>
                                        <li>
		Corrugated fit and arrangement	</li>
                                        <li>
		Inside and outside print	</li>
                                        <li>
		Delivery and opening use	</li>
                                    </ul>
